# GamingHub Production Environment Configuration

DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,web,your-domain.com

# Database Configuration (PostgreSQL)
POSTGRES_DB=gaming_hub_db
POSTGRES_USER=gaming_user
POSTGRES_PASSWORD=gaming_pass_secret
DATABASE_URL=postgres://gaming_user:gaming_pass_secret@db:5432/gaming_hub_db

# Redis Channel Layers & Cache
REDIS_URL=redis://redis:6379/0
USE_REDIS=True

# Google OAuth Credentials (Get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
